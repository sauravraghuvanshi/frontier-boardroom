# Foundry (1st party: OpenAI, xAI, Meta, Mistral)
# Local development authenticates with DefaultAzureCredential.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_IQ_INDEX_NAME=boardroom-iq
AZURE_FOUNDRY_KB_NAME=boardroom-iq
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=boardroom-knowledge-idx
AZURE_SEARCH_KNOWLEDGE_SOURCE=boardroom-knowledge-ks

# Azure Databricks (Anthropic Claude via Mosaic AI Model Serving)
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_ENDPOINT_CLAUDE_SONNET=databricks-claude-sonnet-4-6
DATABRICKS_ENDPOINT_CLAUDE_OPUS=databricks-claude-opus-4-6

# Model registry (format: "<provider>:<deployment-or-endpoint-name>")
MODEL_CEO=foundry:CEO@5
MODEL_CFO=databricks:databricks-claude-sonnet-4-6
MODEL_CMO=foundry:CMO@2
MODEL_CTO=foundry:gpt-5
MODEL_LEGAL=databricks:databricks-claude-opus-4-6

# Storage
AZURE_STORAGE_ACCOUNT=stfrontierboardroom
AZURE_BLOB_CONTAINER=boardroom-knowledge

# Speech & Language (DefaultAzureCredential / managed identity)
AZURE_SPEECH_RESOURCE_ID=
AZURE_SPEECH_REGION=centralindia
AZURE_LANGUAGE_ENDPOINT=

# Telemetry
APPINSIGHTS_CONNECTION_STRING=

# Demo safety: when true, force the recorded fake-debate even if creds exist
USE_FAKE_DEBATE=false

# Frontend (embedded at Vite build time)
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
